# Alchemy (or any archive-capable) RPC endpoints, one per tracked chain
RPC_MAINNET=
RPC_ARBITRUM=
RPC_BASE=
RPC_OPTIMISM=
RPC_POLYGON=
RPC_UNICHAIN=

# Slack delivery — set ONE of the two options below.
# Option A: incoming webhook (simplest)
SLACK_WEBHOOK_URL=
# Option B: bot token + channel (needs chat:write scope, bot invited to the channel)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Optional tuning
# Length of the "last day" window in hours (default 24)
WINDOW_HOURS=24
# Max transactions listed per chain in the Slack message (default 20)
SLACK_MAX_TXS_PER_CHAIN=20
